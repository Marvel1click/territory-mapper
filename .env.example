# Browser-safe provider settings
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
NEXT_PUBLIC_MAPBOX_TOKEN=your-public-mapbox-token
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only settings. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
DNC_ENCRYPTION_KEY_VERSION=1
# Generate with: openssl rand -base64 32
DNC_ENCRYPTION_KEY_V1=base64-encoded-32-byte-key
